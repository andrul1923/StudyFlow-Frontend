# URL base de la API de StudyFlow (backend Django).
# Cada desarrollador la fija según su propia máquina/red local, por ejemplo:
#   VITE_API_BASE=http://127.0.0.1:8000        (backend en la misma máquina)
#   VITE_API_BASE=http://192.168.1.50:8000     (backend accesible por IP de LAN)
VITE_API_BASE=http://127.0.0.1:8000
